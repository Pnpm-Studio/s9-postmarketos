#!/bin/sh
# Give login users (uid >= 1000) the S9 shell setup once: bash + starship + ble.sh + fzf from /etc/skel.
# Skips anyone who already has a ~/.bashrc, so own dotfiles are never overwritten.
awk -F: '$3 >= 1000 && $3 < 60000 { print $1 ":" $6 ":" $7 }' /etc/passwd | while IFS=: read -r u h sh; do
	[ -d "$h" ] && [ ! -e "$h/.bashrc" ] || continue
	cp -a /etc/skel/. "$h/" && chown -R "$u:" "$h"
	[ "$sh" = /bin/ash ] || [ "$sh" = /bin/sh ] && sed -i "s#^\($u:.*\):$sh\$#\1:/bin/bash#" /etc/passwd
done
exit 0
