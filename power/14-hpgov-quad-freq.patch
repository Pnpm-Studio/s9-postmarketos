+static int exynos_hpgov_set_quad_freq(int val)
+{
+	struct cpumask mask;
+	int i;
+
+	if (val < exynos_hpgov.quad_dt || val > exynos_hpgov.maxfreq_table[SINGLE])
+		return -EINVAL;
+
+	/* exynos_hpgov_validate_*() BUG above the table: raise it before the cap, never lower it */
+	for (i = TRIPLE; i <= QUAD; i++)
+		exynos_hpgov.maxfreq_table[i] = max(exynos_hpgov.maxfreq_table[i], val);
+	exynos_hpgov.maxfreq_table[DISABLE] = exynos_hpgov.maxfreq_table[QUAD];
+	exynos_hpgov.quad_cap = val;
+	exynos_hpgov_set_boostable();
+
+	get_online_cpus();
+	cpumask_and(&mask, cpu_online_mask, cpu_coregroup_mask(4));
+	if (!cpumask_empty(&mask))
+		cpufreq_update_policy(cpumask_first(&mask));
+	put_online_cpus();
+
+	return 0;
+}
