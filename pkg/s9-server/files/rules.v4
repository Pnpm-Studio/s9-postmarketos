# S9 inbound firewall (shareable): any RFC1918 LAN, the USB link (ncm0 or rndis0) and the tailnet (tailscale0) may reach SSH, dashboard and web terminal.
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -i lo -j ACCEPT
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A INPUT -m conntrack --ctstate INVALID -j DROP
-A INPUT -p icmp -j ACCEPT
-A INPUT -p udp --sport 67 --dport 68 -j ACCEPT
-A INPUT -i ncm0 -j ACCEPT
-A INPUT -i rndis0 -j ACCEPT
-A INPUT -i tailscale0 -j ACCEPT
-A INPUT -s 10.0.0.0/8 -p tcp --dport 22 -j ACCEPT
-A INPUT -s 172.16.0.0/12 -p tcp --dport 22 -j ACCEPT
-A INPUT -s 192.168.0.0/16 -p tcp --dport 22 -j ACCEPT
-A INPUT -s 10.0.0.0/8 -p tcp --dport 8090 -j ACCEPT
-A INPUT -s 172.16.0.0/12 -p tcp --dport 8090 -j ACCEPT
-A INPUT -s 192.168.0.0/16 -p tcp --dport 8090 -j ACCEPT
-A INPUT -s 10.0.0.0/8 -p tcp --dport 7681 -j ACCEPT
-A INPUT -s 172.16.0.0/12 -p tcp --dport 7681 -j ACCEPT
-A INPUT -s 192.168.0.0/16 -p tcp --dport 7681 -j ACCEPT
COMMIT
