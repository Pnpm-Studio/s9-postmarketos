#!/bin/sh
# Wi-Fi bring-up; keep the noisy PCIe runtime-PM cycle disabled.
(
L=/var/log/wifi.log; date > $L
for i in $(seq 1 30); do ip link show wlan0 >/dev/null 2>&1 && break; sleep 1; done
ip link set wlan0 up >> $L 2>&1
/usr/local/bin/dhd-iovar idletime 0 >> $L 2>&1   # no PCIe runtime-PM sleep/wake cycle: it logged ~25 kernel warnings each time
wpa_supplicant -t -D nl80211,wext -i wlan0 -c /etc/wpa_supplicant/wpa_supplicant.conf > /var/log/wpa.log 2>&1 &
/usr/local/bin/wifi-ip apply >> $L 2>&1   # udhcpc, or the static IP/DNS from /etc/s9/wifi-ip (set in the Wi-Fi page)
sleep 30; { ip addr show wlan0; ip route; wpa_cli -i wlan0 status; } >> $L 2>&1
) </dev/null >/dev/null 2>&1 &
